FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN sed '/^insightface==/d' requirements.txt > /tmp/requirements-without-insightface.txt \
    && python -m pip install --no-cache-dir --default-timeout=600 \
        -r /tmp/requirements-without-insightface.txt \
    && python -m pip install --no-cache-dir --default-timeout=600 \
        "Cython==0.29.37" \
    && python -m pip install --no-cache-dir --default-timeout=600 \
        --no-build-isolation "insightface==0.7.3"

COPY app ./app
COPY config.py .
COPY ui ./ui

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl --fail --silent http://localhost:8501/_stcore/health || exit 1

CMD ["python", "-m", "streamlit", "run", "ui/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
