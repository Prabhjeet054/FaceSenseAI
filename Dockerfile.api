FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl g++ libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN sed '/^insightface==/d' requirements.txt > /tmp/requirements-without-insightface.txt \
    && python -m pip install --no-cache-dir --default-timeout=600 \
        -r /tmp/requirements-without-insightface.txt \
    && python -m pip install --no-cache-dir --default-timeout=600 \
        "Cython==0.29.37" \
    && python -m pip install --no-cache-dir --default-timeout=600 \
        --no-build-isolation "insightface==0.7.3"

COPY app ./app
COPY config.py .

RUN mkdir -p /app/data/raw /app/data/processed /app/data/known_faces /app/models

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl --fail --silent \
    -H "X-API-Key: $${FACESENSE_API_KEY}" \
    http://localhost:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
